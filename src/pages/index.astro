---
const services = [
	{
		name: "Corte clásico",
		description: "Un estilo limpio que nunca pasa de moda.",
		price: "$150",
	},
	{
		name: "Fade / Degradado",
		description: "Transiciones precisas y acabados modernos.",
		price: "$180",
	},
	{
		name: "Corte + barba",
		description: "Un look completo, cuidado al detalle.",
		price: "$250",
	},
];
const whatsappNumber = "5544728148"; // Agrega aquí el número cuando esté disponible
const whatsappMessage = encodeURIComponent(
	"Hola, quisiera agendar una cita en Barrio Barber.",
);

const whatsappUrl = whatsappNumber
	? `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`
	: "";
---

<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<meta
			name="description"
			content="Barrio Barber: proyecto conceptual de barbería con cortes modernos, estilo urbano y atención personalizada."
		/>

		<meta name="theme-color" content="#20232c" />

		<title>Barrio Barber | Tu estilo, tus reglas</title>

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Barrio Barber" />
		<meta
			property="og:title"
			content="Barrio Barber | Tu estilo, tus reglas"
		/>
		<meta
			property="og:description"
			content="Conoce Barrio Barber, un proyecto conceptual de diseño web con estilo urbano, servicios y galería."
		/>
		<meta property="og:url" content="https://barrio-barber.pages.dev/" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<header class="header">
			<a class="logo" href="#inicio">
				BARRIO<span>.</span>
			</a>

			<nav aria-label="Navegación principal">
				<a href="#inicio">Inicio</a>
				<a href="#servicios">Servicios</a>
				<a href="#nosotros">Nosotros</a>
				<a href="#galeria">Galería</a>
				<a href="#contacto">Contacto</a>
			</nav>

			<a class="header-cta" href="#contacto">Agenda tu corte ↗</a>
		</header>

		<main>
			<section class="hero" id="inicio">
				<div class="hero-content">
					<p class="eyebrow">
						<span class="dot"></span>
						BARBERÍA · ESTILO URBANO
					</p>

					<h1>
						TU ESTILO.<br />
						TUS <span>REGLAS.</span>
					</h1>

					<p class="description">
						No es solo un corte. Es la forma en la que te presentas
						al mundo. Encuentra tu estilo con nosotros.
					</p>

					<div class="hero-actions">
						<a class="button-primary" href="#contacto">
							QUIERO MI CORTE <span>↗</span>
						</a>
						<a class="button-secondary" href="#servicios">
							Explorar servicios ↓
						</a>
					</div>

					<div class="hero-note">
						<span class="note-mark">✳</span>
						<p>
							BUEN CORTE. BUENA ACTITUD.<br />SIN COMPLICACIONES.
						</p>
					</div>
				</div>

				<div class="hero-image">
					<img
						src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1200&q=85"
						alt="Interior de una barbería con estilo moderno"
					/>
					<div class="image-label">
						<span>01 / BARRIO BARBER</span>
						<span>EST. 2026</span>
					</div>
					<div class="image-sticker">
						TU<br />ESTILO<br />TUS<br />REGLAS.
					</div>
				</div>

				<div class="vertical-label">ESTILO QUE HABLA POR TI</div>
			</section>

			<section class="services" id="servicios">
				<p class="section-kicker">LO QUE HACEMOS</p>
				<h2>BIEN HECHO.<br />SIN EXCUSAS.</h2>

				<div class="service-list">
					{
						services.map((service, index) => (
							<article class="service-item">
								<span>0{index + 1}</span>

								<div class="service-info">
									<h3>{service.name}</h3>
									<p>{service.description}</p>
								</div>

								<strong class="service-price">
									{service.price}
								</strong>
							</article>
						))
					}
				</div>
			</section>

			<section class="about-contact">
				<section class="about" id="nosotros">
					<div class="about-heading">
						<p class="section-kicker">MÁS QUE UNA BARBERÍA</p>
						<h2>EL BARRIO.<br />NUESTRA IDENTIDAD.</h2>
					</div>

					<div class="about-content">
						<p>
							En Barrio Barber creemos que un buen corte es parte
							de tu identidad. Creamos un espacio donde el estilo,
							la atención al detalle y la buena actitud se
							encuentran.
						</p>

						<p>
							Desde un corte clásico hasta un degradado moderno,
							buscamos que cada visita termine con un estilo que
							vaya contigo.
						</p>

						<a class="about-link" href="#servicios">
							CONOCE NUESTROS SERVICIOS ↗
						</a>
					</div>
				</section>

				<section class="contact" id="contacto">
					<p class="section-kicker">TU SIGUIENTE CORTE</p>
					<h2>¿LISTO PARA<br />CAMBIAR EL JUEGO?</h2>

					<p>
						¿Tienes dudas sobre un servicio o quieres agendar una
						cita? Escríbenos para conocer la disponibilidad.
					</p>

					<div class="contact-details">
						<div class="contact-detail">
							<h3>UBICACIÓN</h3>
							<p>Zona Centro, Ciudad de México</p>
							<small>
								Ubicación ficticia para demostración. No
								corresponde a un establecimiento real.
							</small>
						</div>

						<div class="contact-detail">
							<h3>HORARIOS</h3>
							<p>Lunes a sábado · 10:00 a 20:00</p>
							<small>
								Horario ilustrativo, no confirmado para un
								negocio real.
							</small>
						</div>
					</div>

					<div class="contact-actions">
						{
							whatsappUrl ? (
								<a
									class="contact-whatsapp"
									href={whatsappUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									AGENDAR POR WHATSAPP ↗
								</a>
							) : (
								<span class="contact-whatsapp contact-disabled">
									WHATSAPP: NÚMERO PENDIENTE
								</span>
							)
						}
					</div>

					<p class="contact-note">
						Proyecto conceptual. Los datos definitivos se
						configurarán cuando la página se adapte a un negocio
						real.
					</p>
				</section>
			</section>

			<section class="gallery" id="galeria">
				<div class="gallery-heading">
					<div>
						<p class="section-kicker">EL ESTILO HABLA</p>
						<h2>FRESCOS.<br />LIMPIOS. ÚNICOS.</h2>
					</div>

					<p class="gallery-description">
						Cada corte tiene su personalidad. Encuentra el estilo
						que va contigo.
					</p>
				</div>

				<div class="gallery-grid">
					<article class="gallery-card gallery-card-large">
						<img
							src="/images/Corte1.jpg"
							alt="Corte degradado moderno"
							loading="lazy"
						/>
						<span>01 / FADE</span>
					</article>

					<article class="gallery-card">
						<img
							src="/images/Corte2.jpg"
							alt="Arreglo profesional de barba"
							loading="lazy"
						/>
						<span>02 / BARBA</span>
					</article>

					<article class="gallery-card">
						<img
							src="/images/Corte3.jpg"
							alt="Corte clásico masculino"
							loading="lazy"
						/>
						<span>03 / CLÁSICO</span>
					</article>

					<article class="gallery-card">
						<img
							src="/images/Corte4.jpg"
							alt="Corte degradado moderno con diseño"
							loading="lazy"
						/>
						<span>04 / FADE 02</span>
					</article>
				</div>
			</section>
		</main>

		<footer id="nosotros">
			<a class="logo" href="#inicio">BARRIO<span>.</span></a>
			<p>Proyecto conceptual de diseño web · 2026</p>
		</footer>
	</body>
</html>

<style>
	.service-info h3 {
		margin: 0;
	}

	.service-info p {
		margin: 8px 0 0;
		color: #d4d0c8;
		font-size: 13px;
		line-height: 1.6;
	}

	.service-price {
		color: #d7f75b;
		font-size: 18px;
		white-space: nowrap;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #fff4e5;
		color: #20232c;
		font-family: "DM Sans", sans-serif;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.header {
		min-height: 78px;
		padding: 18px 6%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid #20232c20;
	}

	.logo {
		font-family: "Barlow Condensed", sans-serif;
		font-weight: 900;
		font-size: 30px;
		letter-spacing: -1px;
	}

	.logo span {
		color: #ff6b35;
	}

	nav {
		display: flex;
		gap: 28px;
		font-size: 13px;
		font-weight: 600;
	}

	nav a:hover,
	.button-secondary:hover {
		color: #ff6b35;
	}

	.header-cta {
		background: #d7f75b;
		padding: 13px 18px;
		font-size: 12px;
		font-weight: 700;
	}

	.hero {
		min-height: 590px;
		padding: 62px 8% 56px;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		gap: 48px;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		max-width: 590px;
	}

	.eyebrow,
	.section-kicker {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.dot {
		width: 9px;
		height: 9px;
		background: #ff6b35;
		border-radius: 50%;
	}

	h1,
	h2 {
		font-family: "Barlow Condensed", sans-serif;
		font-weight: 900;
		letter-spacing: -2px;
		line-height: 0.88;
		margin: 28px 0;
	}

	h1 {
		font-size: clamp(66px, 8.2vw, 112px);
	}

	h1 span {
		color: #ff6b35;
	}

	.description {
		max-width: 410px;
		line-height: 1.8;
		font-size: 15px;
		color: #55545a;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 22px;
		margin-top: 28px;
	}

	.button-primary {
		padding: 17px 20px;
		background: #20232c;
		color: #fff4e5;
		font-size: 12px;
		font-weight: 700;
	}

	.button-primary span {
		color: #d7f75b;
		margin-left: 10px;
	}

	.button-secondary {
		font-size: 12px;
		font-weight: 700;
	}

	.hero-note {
		display: flex;
		align-items: center;
		gap: 13px;
		margin-top: 48px;
	}

	.note-mark {
		font-size: 32px;
		color: #ff6b35;
	}

	.hero-note p {
		font-size: 10px;
		font-weight: 700;
		line-height: 1.7;
		letter-spacing: 1px;
	}

	.hero-image {
		height: 460px;
		position: relative;
		background: #d7f75b;
	}

	.hero-image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.image-label {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		display: flex;
		justify-content: space-between;
		padding: 15px;
		background: #20232ce8;
		color: white;
		font-size: 9px;
		letter-spacing: 1px;
	}

	.image-sticker {
		position: absolute;
		top: 22px;
		right: -22px;
		background: #d7f75b;
		width: 96px;
		height: 96px;
		display: grid;
		place-content: center;
		transform: rotate(7deg);
		text-align: center;
		font-family: "Barlow Condensed", sans-serif;
		font-weight: 900;
		line-height: 1;
		font-size: 19px;
	}

	.vertical-label {
		position: absolute;
		bottom: 24px;
		right: 2%;
		writing-mode: vertical-rl;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	.services {
		padding: 80px 8%;
		background: #20232c;
		color: #fff4e5;
	}

	.section-kicker {
		color: #ff6b35;
	}

	h2 {
		font-size: clamp(48px, 6vw, 76px);
	}

	.service-list {
		margin-top: 38px;
	}

	.service-item {
		display: grid;
		grid-template-columns: 50px 1fr 30px;
		align-items: center;
		gap: 12px;
		border-top: 1px solid #ffffff35;
		padding: 18px 0;
	}

	.service-item > span {
		font-size: 12px;
		color: #d7f75b;
	}

	.service-item h3 {
		font-family: "Barlow Condensed", sans-serif;
		font-size: clamp(23px, 3vw, 32px);
		margin: 0;
	}

	.contact {
		padding: 75px 8%;
		background: #d7f75b;
	}

	.contact-details {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		margin-top: 28px;
	}

	.contact-detail h3 {
		margin: 0 0 8px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 1.5px;
	}

	.contact-detail p {
		margin: 0;
		font-size: 14px;
		font-weight: 600;
		line-height: 1.7;
	}

	.contact-detail small {
		display: block;
		margin-top: 6px;
		font-size: 11px;
		line-height: 1.6;
		color: #454a30;
	}

	.contact p:last-child {
		max-width: 560px;
		line-height: 1.8;
		font-size: 14px;
	}

	footer {
		background: #20232c;
		color: #fff4e5;
		padding: 26px 6%;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
	}

	footer p {
		font-size: 11px;
	}

	@media (max-width: 760px) {
		.header {
			flex-wrap: wrap;
			padding: 18px 5%;
		}

		nav {
			order: 3;
			width: 100%;
			justify-content: space-between;
			gap: 12px;
		}

		.header-cta {
			padding: 11px;
			font-size: 10px;
		}

		.hero {
			grid-template-columns: 1fr;
			padding: 48px 6% 64px;
			gap: 34px;
		}

		.hero-image {
			height: 360px;
			margin-right: 12px;
		}

		.image-sticker {
			right: -12px;
		}

		.vertical-label {
			display: none;
		}

		.services,
		.contact {
			padding: 58px 6%;
		}

		footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}
	}

	.gallery {
		padding: 80px 8%;
		background: #fff4e5;
		color: #20232c;
	}

	.gallery-heading {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 30px;
		margin-bottom: 35px;
	}

	.gallery-heading h2 {
		margin-bottom: 0;
	}

	.gallery-description {
		max-width: 300px;
		font-size: 14px;
		line-height: 1.8;
		color: #55545a;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.gallery-card {
		position: relative;
		height: 300px;
		overflow: hidden;
		background: #20232c;
	}

	.gallery-card-large {
		grid-row: span 2;
		height: 618px;
	}

	.gallery-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.gallery-card:hover img {
		transform: scale(1.04);
	}

	.gallery-card span {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 15px;
		color: #fff4e5;
		background: linear-gradient(transparent, #20232ce8);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
	}

	@media (max-width: 760px) {
		.gallery {
			padding: 58px 6%;
		}

		.gallery-heading {
			align-items: start;
			flex-direction: column;
			gap: 12px;
		}

		.gallery-grid {
			grid-template-columns: 1fr;
			gap: 14px;
		}

		.gallery-card,
		.gallery-card-large {
			height: 300px;
			grid-row: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-card img {
			transition: none;
		}

		.gallery-card:hover img {
			transform: none;
		}
	}

	/* Sección Nosotros */

	.about {
		padding: 80px 8%;
		display: grid;
		grid-template-columns: 1fr;
		gap: 18px;
		align-items: start;
		background: #fff4e5;
		color: #20232c;
	}

	.about-heading {
		max-width: 800px;
	}

	.about h2 {
		margin: 20px 0;
	}

	.about-content {
		max-width: 680px;
	}

	.about-content p {
		font-size: 15px;
		line-height: 1.9;
		color: #55545a;
	}

	.about-link {
		display: inline-block;
		margin-top: 14px;
		font-size: 12px;
		font-weight: 700;
		border-bottom: 2px solid #ff6b35;
		padding-bottom: 6px;
	}

	/* Botones de contacto */
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.contact-whatsapp {
		display: inline-block;
		padding: 15px 20px;
		font-size: 12px;
		font-weight: 700;
	}

	.contact-whatsapp {
		background: #20232c;
		color: #fff4e5;
	}

	.contact-disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.contact-note {
		margin-top: 24px;
		font-size: 12px !important;
	}

	/* Nosotros y contacto en dos columnas */
	.about-contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: stretch;
		background: #fff4e5;
	}

	.about-contact .about {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 70px 10%;
		min-width: 0;
	}

	.about-contact .about-content {
		max-width: 100%;
	}

	.about-contact .contact {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 70px 10%;
		min-width: 0;
	}

	.about-contact .contact h2 {
		font-size: clamp(40px, 4.2vw, 64px);
	}

	.about-contact .contact-actions {
		flex-direction: column;
	}

	.about-contact .contact-whatsapp,
	.about-contact .contact-secondary {
		text-align: center;
	}

	@media (max-width: 760px) {
		.about-contact {
			grid-template-columns: 1fr;
		}

		.about-contact .about,
		.about-contact .contact {
			padding: 58px 6%;
		}

		.about-contact .contact h2 {
			font-size: clamp(42px, 10vw, 60px);
		}
	}
</style>
